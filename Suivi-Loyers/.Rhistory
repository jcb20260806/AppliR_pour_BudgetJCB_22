#P1
LagNbr <- 24L
# on ne prend que les mouvements récurents
MvtByMoisAbs<-subset(NewMvtAll, PBM %in% PBMRecurrent)
MvtByMoisAbs$In<-ifelse(MvtByMoisAbs$MontantE>=0,MvtByMoisAbs$MontantE,0)
MvtByMoisAbs$Out<-ifelse(MvtByMoisAbs$MontantE<=0,MvtByMoisAbs$MontantE,0)
# on agrège MoisABS par MoisAbs
MvtByMoisAbs<-aggregate(cbind(MontantE, In,Out) ~ MoisAbs, data = MvtByMoisAbs, sum, na.rm = TRUE)
# on fait un running solde
MvtByMoisAbs[,"RunSolde"] <- cumsum(MvtByMoisAbs$MontantE)
MvtByMoisAbs[,"RunSoldeIn"] <- cumsum(MvtByMoisAbs$In)
MvtByMoisAbs[,"RunSoldeOut"] <- cumsum(MvtByMoisAbs$Out)
# on décale pour faire le delta de solde
MvtByMoisAbs$RunSoldep12<-lag(MvtByMoisAbs$RunSolde, n = LagNbr, default = NA)
MvtByMoisAbs$RunSoldeInp12<-lag(MvtByMoisAbs$RunSoldeIn, n = LagNbr, default = NA)
MvtByMoisAbs$RunSoldeOutp12<-lag(MvtByMoisAbs$RunSoldeOut, n = LagNbr, default = NA)
# on calcule le delta et on divise par le nombre de mois
MvtByMoisAbs$DeltaMoyen<-(MvtByMoisAbs$RunSolde-MvtByMoisAbs$RunSoldep12)/LagNbr
MvtByMoisAbs$InMoyen<-(MvtByMoisAbs$RunSoldeIn-MvtByMoisAbs$RunSoldeInp12)/LagNbr
MvtByMoisAbs$OutMoyen<-(MvtByMoisAbs$RunSoldeOut-MvtByMoisAbs$RunSoldeOutp12)/LagNbr
# Plot
parWhat<-MvtByMoisAbs[MvtByMoisAbs$MoisAbs>=503,]
#
#parUnit<-"Euros In/Out"
P2<-ggplot(parWhat, aes(x=MoisAbs))
P2<-P2+scale_y_continuous(name=parUnit,sec.axis = sec_axis(~ . * .5, name = "Manquant par Mois"))
P2<-P2+scale_x_continuous("Mois",breaks=parWhat$MoisAbs,labels=parWhat$MoisAbs,guide = guide_axis(angle = 90))
p2<-P2+ggtitle(paste("Delta Mensuel sur base des ", LagNbr ,"derniers précédents"))
P2<-P2+geom_line(aes(y =-DeltaMoyen*2, color="Delta*2"  )) #,
P2<-P2+geom_line(aes(y =-OutMoyen, color="Out"  ) , linetype = "dashed")#color="DeltaMoins",
P2<-P2+geom_line(aes(y =InMoyen, color="In"  )) #,
P2<-P2+geom_vline(xintercept =FirstMoisAbsProj, "x", linetype = "dashed")
P2<-P2+geom_text(y=-round(parWhat$DeltaMoyen,2)*2.3,label=as.character (round(parWhat$DeltaMoyen,0)),angle=90,nudge_y = 0.5)
P2
PrepareMvtByMoisAbs<-function(InDF,TypeIn,parLagNbr,Divide,WindSize,parLoess=TRUE){
MvtByMoisAbs<-subset(InDF, Type %in% TypeIn)
MvtByMoisAbs<-aggregate(MvtByMoisAbs$MontantE, by=list(MoisAbs=MvtByMoisAbs$MoisAbs), FUN=sum,r.na=0)
names(MvtByMoisAbs)[names(MvtByMoisAbs) == 'x'] <- 'MontantE'
MvtByMoisAbs[,"RunSolde"] <- cumsum(MvtByMoisAbs$MontantE)
MvtByMoisAbs$RunSoldep12<-lag(MvtByMoisAbs$RunSolde, n = parLagNbr, default = NA)
MvtByMoisAbs$AveIn<-(MvtByMoisAbs$RunSolde-MvtByMoisAbs$RunSoldep12)/Divide
return (tail(MvtByMoisAbs,WindSize))
}
