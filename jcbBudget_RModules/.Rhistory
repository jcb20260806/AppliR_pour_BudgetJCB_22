jcbPivot<-function(parDF,parRow,parCol,parVal){
pt <- PivotTable$new()
pt$addData(parDF)
pt$addColumnDataGroups(parCol,addTotal=TRUE)
pt$addRowDataGroups(parRow,addTotal=TRUE)
pt$defineCalculation(calculationName="MontantE",
summariseExpression="sum(MontantE, na.rm=FALSE)",format="%.2f")
return(pt)}
DictOfTiers<-jcbGetDictOfTiers("../Python/HCG/DictOfTiers.json")
# Extractions des Mouvements de la db
#
MvtReelAll<-jcbGetMvtReel()
MvtReelBarBar<-jcbGetMvtReelBarBar()
Dec_All<-jcbGetDecAll("../Python/Dec")
SPA_All<-jcbGetSPAAll("../Python/SPA")
HCC_All<-jcbGetHCCAll("../Python/HCC")
Quot_All<-jcbGetQuotAll("../Python/Quot")
HCG_All<-jcbGetHCGAll("../Python/HCG")
SCF_2020<-jcbGetSCF2020("../Python/SCF")
HCC_Bar<-jcbGetHCCAllBar("../Python/HCC_Bar_All")
ptHCG<-jcbPivot(HCG_All,"Code.Lib","AnReel")
t1<-ptHCG$renderPivot()
ptHCGT<-jcbPivot(HCG_All,"Tiers","AnReel")
#t2<-ptHCGT$renderPivot()
HCG_All$Code<-ifelse(HCG_All$Tiers!="NETTOYAG",as.character(HCG_All$Code),"A01")
HCG_All$Code.Tiers<-ifelse(HCG_All$Tiers!="NETTOYAG",as.character(HCG_All$Code.Tiers),"A01-NETTOYAG")
HCG_All$Code.Lib<-ifelse(HCG_All$Tiers!="NETTOYAG",as.character(HCG_All$Code.Lib),"A01-Nettoyage")
HCG_All$Lib<-ifelse(HCG_All$Tiers!="NETTOYAG",as.character(HCG_All$Code.Tiers),"Nettoyage")
ptHCG<-jcbPivot(HCG_All,"Code.Lib","AnReel")
t3<-ptHCG$renderPivot()
ptHCG_All_A04<-jcbPivot(HCG_All[substr(HCG_All$Code.Tiers,1,3)=="A04",],"Code.Tiers","AnReel")
ptA04<-ptHCG_All_A04$renderPivot()
ptHCG_CP<-jcbPivot(HCG_All[HCG_All$Code=="A10",],"Commentaire","AnReel")
ptCP<-ptHCG_CP$renderPivot()
HCG_Com1<-HCG_All[HCG_All$Code!="A10",]
ptHCG_Com1<-jcbPivot(HCG_Com1,"Code.Lib","AnReel")
ptCC<-ptHCG_Com1$renderPivot()
HCG_Com1A<-aggregate(HCG_Com1$MontantE, by=list(AnReel=HCG_Com1$AnReel,Code=HCG_Com1$Code), FUN=sum)
HCG_Com1A$M<- -HCG_Com1A$x
bp<- ggplot(HCG_Com1A, aes(x=HCG_Com1A$AnReel, y=HCG_Com1A$M, fill=HCG_Com1A$Code))+
geom_bar(width = 1, stat = "identity")
ggsave("./png/myplot.png")
MvtReelFour<-MvtReelAll[(MvtReelAll$Four==TRUE & MvtReelAll$AnReel>2015),]
MvtReelFour$Code<-substr(MvtReelFour$PouF,1,3)
pt1 <- PivotTable$new()
pt1$addData(MvtReelFour)
pt1$addColumnDataGroups("AnReel",addTotal=FALSE)
pt1$addRowDataGroups("PouF")
pt1$defineCalculation(calculationName="MontantE",
summariseExpression="sum(MontantE, na.rm=FALSE)",format="%.2f")
ptMvt<-pt1$renderPivot()
pt1 <- PivotTable$new()
pt1$addData(MvtReelFour[MvtReelFour$Code=="A99",])
pt1$addColumnDataGroups("AnReel",addTotal=FALSE)
pt1$addRowDataGroups("Libelle")
pt1$defineCalculation(calculationName="MontantE",
summariseExpression="sum(MontantE, na.rm=FALSE)",format="%.2f")
ptA99<-pt1$renderPivot()
# ZENITO de vien KLINKENB dans MvtReelFour et HCG_Com1 et on ne prend que <2021F
MvtReelFour<-MvtReelFour[MvtReelFour$AnReel<2021,]
MvtReelFour$Tiers<-ifelse(MvtReelFour$Tiers=="ZENITO","KLINKENB",MvtReelFour$Tiers)
HCG_All_C<-HCG_All
HCG_All_C$Tiers<-ifelse(HCG_All_C$Tiers=="ZENITO","KLINKENB",HCG_All_C$Tiers)
# Autres Corrections
HCG_All_C$Tiers<-ifelse(HCG_All_C$Document=="20.011","MARICHAL",HCG_All_C$Tiers)
HCG_All_C<-HCG_All_C[HCG_All_C$Tiers!="zNoTiers",]
MvtReelFourbyT<-aggregate(MvtReelFour$MontantE, by=list(Tiers=MvtReelFour$Tiers), FUN=sum)
HCG_All_C_byT<-aggregate(HCG_All_C$MontantE, by=list(Tiers=HCG_All_C$Tiers), FUN=sum)
#HCG_All_byT$AnReel<-as.character((HCG_All_byT$AnReel))
#HCG_AllbyYbyAxx$Code<-substr(HCG_AllbyYbyAxx$Code,1,3)
SoldeFour<-left_join(HCG_All_C_byT, MvtReelFourbyT, by = c("Tiers"))
SoldeFour$x.x[is.na(SoldeFour$x.x)] <- 0
SoldeFour$x.y[is.na(SoldeFour$x.y)] <- 0
SoldeFour$Solde<--SoldeFour$x.x+SoldeFour$x.y
pt<-PivotTable$new()
pt$addData(SoldeFour)
#ptSF$addColumnDataGroups("AnReel",addTotal=TRUE)
pt$addRowDataGroups("Tiers")
pt$defineCalculation(calculationName="Solde",
summariseExpression="sum(Solde, na.rm=FALSE)",format="%.2f")
ptSF<-pt$renderPivot()
SS<-left_join(SoldeFour, SCF_2020, by = c("Tiers"))
SST<-SS[c(1,4,5)]
SST$MontantE<-ifelse(is.na(SST$MontantE),0,SST$MontantE)
KS<-SST %>%mutate( MontantE=cell_spec(SST$MontantE, "html", color = ifelse(SST$MontantE > 0, "red", "blue"), background = ifelse(SST$MontantE > 0, "yellow", ""))) %>%
mutate( Solde=cell_spec(round(SST$Solde, digits = 3), "html", color = ifelse(SST$Solde > 0, "red", "blue"), background = ifelse(SST$Solde > 0,"yellow", "")))%>%
mutate( Tiers=cell_spec(SST$Tiers, "html", color = ifelse(abs(SST$Solde-SST$MontantE)>0.02, "red", "blue"), background = ifelse(abs(SST$Solde-SST$MontantE)>0.02,"yellow", "")))%>%
kable(format = "html", escape = F) %>%
kable_styling("striped", full_width = F,position = "float_right") %>% returnValue()
