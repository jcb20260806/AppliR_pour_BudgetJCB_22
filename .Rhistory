P2<-P2+geom_line(aes(y =InMoyen, color="In"  )) #,
P2<-P2+geom_vline(xintercept =FirstMoisAbsProj, "x", linetype = "dashed")
P2<-P2+geom_text(y=-round(parWhat$DeltaMoyen,2)*2.3,label=as.character (round(parWhat$DeltaMoyen,0)),angle=90,nudge_y = 0.5)
P2
PrepareMvtByMoisAbs<-function(InDF,TypeIn,parLagNbr,Divide,WindSize,parLoess=TRUE){
MvtByMoisAbs<-subset(InDF, Type %in% TypeIn)
MvtByMoisAbs<-aggregate(MvtByMoisAbs$MontantE, by=list(MoisAbs=MvtByMoisAbs$MoisAbs), FUN=sum,r.na=0)
names(MvtByMoisAbs)[names(MvtByMoisAbs) == 'x'] <- 'MontantE'
MvtByMoisAbs[,"RunSolde"] <- cumsum(MvtByMoisAbs$MontantE)
MvtByMoisAbs$RunSoldep12<-lag(MvtByMoisAbs$RunSolde, n = parLagNbr, default = NA)
MvtByMoisAbs$AveIn<-(MvtByMoisAbs$RunSolde-MvtByMoisAbs$RunSoldep12)/Divide
return (tail(MvtByMoisAbs,WindSize))
}
#
PlotCoutParNature<-function(InDF,TypeIn,Titre){
parWhat<-InDF
#parWhat<-parWhat[parWhat$MoisAbs<LastMoisAbs,]
parUnit<-"Euros"
P2<-ggplot(parWhat, aes(x=MoisAbs))
parWhat$Date<-FromMoisAbsToSDate(parWhat$MoisAbs)
P2<-P2+scale_x_continuous("Mois",breaks=parWhat$MoisAbs,labels=FromMoisAbsToSDate(parWhat$MoisAbs),guide = guide_axis(angle            = 90))
P2<-P2+ggtitle(Titre)
P2<-P2+geom_line(aes(y =-AveIn))
P2<-P2+coord_cartesian(ylim=c(0, 100+100*max(-parWhat$AveIn)%/%100))
P2<-P2+geom_vline(xintercept =FirstMoisAbsProj, "x", linetype = "dashed")
return (P2)
}
